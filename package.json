{
  "name": "jb-select",
  "description": "select web component",
  "type": "module",
  "author": {
		"name": "mohammad javad bathaei",
		"email": "javadbat@gmail.com"
	},
  "keywords": [
    "jb",
    "jb-select",
    "select",
    "autocomplete",
    "dropdown",
    "select box",
    "web component",
    "react component"
  ],
  "version": "8.0.0",
  "bugs": "https://github.com/javadbat/jb-select/issues",
  "homepage": "https://javadbat.github.io/design-system/?path=/story/components-form-elements-jbselect",
  "license": "MIT",
  "files": [
    "LICENSE",
    "README.md",
    "web-component/custom-elements.json",
    "web-component/lib/",
    "web-component/dist/",
    "option/",
    "option-list/",
    "listbox/",
    "react/",
    "react/dist/"
  ],
  "types": "./web-component/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./web-component/dist/index.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react/dist/index.d.ts",
      "default": "./react/index.js"
    },
    "./option": {
      "types": "./option/web-component/dist/index.d.ts",
      "default": "./option/index.js"
    },
    "./option/web-component": {
      "types": "./option/web-component/dist/index.d.ts",
      "default": "./option/web-component/index.js"
    },
    "./option/react": {
      "types": "./option/react/dist/index.d.ts",
      "default": "./option/react/index.js"
    },
    "./option-list": {
      "types": "./option-list/web-component/dist/index.d.ts",
      "default": "./option-list/index.js"
    },
    "./option-list/web-component": {
      "types": "./option-list/web-component/dist/index.d.ts",
      "default": "./option-list/web-component/index.js"
    },
    "./option-list/react": {
      "types": "./option-list/react/dist/index.d.ts",
      "default": "./option-list/react/index.js"
    },
    "./listbox": {
      "types": "./listbox/web-component/dist/index.d.ts",
      "default": "./listbox/index.js"
    },
    "./listbox/web-component": {
      "types": "./listbox/web-component/dist/index.d.ts",
      "default": "./listbox/web-component/index.js"
    },
    "./listbox/react": {
      "types": "./listbox/react/dist/index.d.ts",
      "default": "./listbox/react/index.js"
    },
    "./*": "./*"
  },
  "main": "index.js",
  "customElements": "web-component/custom-elements.json",
  "repository": {
		"type": "git",
		"url": "git@github.com:javadbat/jb-select.git"
  },
  "dependencies": {
    "jb-validation": "^1.0.0",
    "jb-button": "^4.0.0",
    "jb-popover": "^1.13.0",
    "jb-core":"^0.35.0"
  },
  "devDependencies": {
    "jb-form":"^0.12.0"
  }
}
